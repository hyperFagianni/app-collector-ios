{
  "expo": {
    "name": "Duel Album",
    "slug": "duel-album",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "duelalbum",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.duelalbum.app",
      "adaptiveIcon": {
        "backgroundColor": "#122048",
        "foregroundImage": "./assets/images/logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0B12",
          "image": "./assets/images/logo.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bf1cb9d-63aa-4725-97aa-aedfefe8f82e"
      }
    },
    "owner": "mattia.nico"
  }
}
